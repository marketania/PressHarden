#!/usr/bin/env bash
set -uo pipefail
# Internal target context is rebuilt for each CLI invocation, never inherited.
unset _PH_TARGET_EXCLUSIONS _PH_FLEET_ROOT

# Resolve the real program directory even when the CLI is invoked through the
# user-install symlink (for example ~/.local/bin/pressharden).
_ph_self="${BASH_SOURCE[0]}"
while [ -L "$_ph_self" ] && command -v readlink >/dev/null 2>&1; do
  _ph_self_dir=$(cd -P "$(dirname "$_ph_self")" 2>/dev/null && pwd -P) || break
  _ph_link=$(readlink "$_ph_self" 2>/dev/null) || break
  case "$_ph_link" in /*) _ph_self="$_ph_link" ;; *) _ph_self="$_ph_self_dir/$_ph_link" ;; esac
done
PRESSHARDEN_DIR="$(cd -P "$(dirname "$_ph_self")" 2>/dev/null && pwd -P)"
unset _ph_self _ph_self_dir _ph_link 2>/dev/null || true
VERSION="$(cat "$PRESSHARDEN_DIR/VERSION" 2>/dev/null || printf 'unknown')"
# Presentation and target flags work before or after the command. Normalize
# named targets separately so they can never become an action or subcommand.
_ph_args=(); _ph_target=(); _ph_named_target=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --color=*) PRESSHARDEN_COLOR="${1#--color=}"; export PRESSHARDEN_COLOR ;;
    --color)
      [ "$#" -ge 2 ] || { printf 'Missing color mode.\n' >&2; exit 2; }
      shift; PRESSHARDEN_COLOR="$1"; export PRESSHARDEN_COLOR ;;
    --no-color) PRESSHARDEN_COLOR=never; export PRESSHARDEN_COLOR ;;
    --target|--target=*)
      [ "$_ph_named_target" -eq 0 ] || { printf 'Use one target only.\n' >&2; exit 2; }
      _ph_named_target=1
      if [ "$1" = --target ]; then
        [ "$#" -ge 2 ] || { printf 'Missing target.\n' >&2; exit 2; }; shift; _ph_value="$1"
      else _ph_value="${1#--target=}"; fi
      case "$_ph_value" in ''|-*) printf 'Empty or invalid target.\n' >&2; exit 2 ;; esac
      _ph_target=("$_ph_value") ;;
    *) _ph_args+=("$1") ;;
  esac
  shift
done
set -- "${_ph_args[@]}"
unset _ph_args _ph_value
# Help must never fall through into an updater or mutation handler.
if [ "$#" -gt 1 ] && [ "${1:-}" != help ]; then
  for _ph_arg in "${@:2}"; do
    case "$_ph_arg" in
      -h|--help)
        case "$1" in
          status|check) set -- help status ;;
          php) set -- help php ;;
          auto-update|auto-updates) set -- help updates ;;
          wp-settings|lock|unlock|lock-status|file-mods|salts) set -- help configure ;;
          update) set -- help update ;;
          config|config-new|sites|doctor|version|-V|--version) set -- help setup ;;
        esac
        if [ "${1:-}" = help ]; then _ph_target=(); _ph_named_target=0; fi
        break ;;
    esac
  done
fi
unset _ph_arg
PRESSHARDEN_PORTABLE=0
[ -f "$PRESSHARDEN_DIR/.pressharden-portable" ] && PRESSHARDEN_PORTABLE=1

if [ "$PRESSHARDEN_PORTABLE" = 1 ]; then
  CONFIG_FILE="${PRESSHARDEN_CONFIG_FILE:-$PRESSHARDEN_DIR/config/config}"
else
  CONFIG_FILE="${PRESSHARDEN_CONFIG_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/pressharden/config}"
fi

# New scans must not load half-replaced libraries during an update. Existing
# running scans still need to finish before an administrator starts updating.
if [ -e "$PRESSHARDEN_DIR/.pressharden-update.lock" ] || [ -L "$PRESSHARDEN_DIR/.pressharden-update.lock" ]; then
  case "${1:-help}" in
    update|help|-h|--help|-V|--version|version) : ;;
    *) printf 'PressHarden update/recovery lock is present. Scans are blocked; see docs/UPDATING.md.\n' >&2; exit 2 ;;
  esac
fi

# Config advice must work even with a broken config, without executing it.
if [ "${1:-}" = config-new ]; then
  [ "$#" -eq 1 ] && [ "$_ph_named_target" -eq 0 ] || { printf 'Usage: pressharden config-new\n' >&2; exit 2; }
  command -v php >/dev/null 2>&1 || { printf 'config-new requires PHP CLI.\n' >&2; exit 2; }
  exec php "$PRESSHARDEN_DIR/lib/config-options.php" "$PRESSHARDEN_DIR/config/config.example" "$CONFIG_FILE"
fi

# Preserve exact exported values so one-shot environment overrides win over
# persistent config without truncating roots or multiline exclusion lists.
# shellcheck source=lib/cli-ui.sh
. "$PRESSHARDEN_DIR/lib/cli-ui.sh"
ph_cli_save_environment || exit 2
if [ -e "$CONFIG_FILE" ] || [ -L "$CONFIG_FILE" ]; then
  [ -f "$CONFIG_FILE" ] && [ -r "$CONFIG_FILE" ] || { printf 'Cannot read PressHarden configuration: %q. No operation started.\n' "$CONFIG_FILE" >&2; exit 2; }
  if ! bash -n "$CONFIG_FILE" 2>/dev/null; then
    printf 'Invalid Bash syntax in PressHarden configuration: %q. No operation started.\n' "$CONFIG_FILE" >&2
    printf 'Correct the configuration first; config-new previews template additions without loading it.\n' >&2
    exit 2
  fi
  # The file remains trusted shell code. Reject loading errors before resolving
  # any target; a partially loaded configuration must never choose the fleet.
  if ! . "$CONFIG_FILE"; then
    printf 'PressHarden configuration returned an error: %q. No operation started.\n' "$CONFIG_FILE" >&2
    exit 2
  fi
fi
ph_cli_restore_environment || exit 2
export PRESSHARDEN_PORTABLE

ph_ui_init || exit 2

usage() {
  local topic="${1:-quick}"
  [ "$#" -le 1 ] || { printf 'Usage: pressharden help [all|status|configure|php|updates|setup|update]\n' >&2; return 2; }
  ph_ui_heading "PressHarden v$VERSION — WordPress hardening and security policy"
  case "$topic" in
    quick)
      cat <<'EOF'

Everyday commands
  status [target]               WordPress + PHP overview; read-only
  status -wp | -php | -updates | -locks [target]
                                Select one or more areas
  status --verbose [target]     Detailed values for the selected areas
  lock | unlock [target]       Guarded file-modification policy changes
  sites / doctor [target]      Find sites / diagnose local requirements

Manage
  config / config-new / update / version
  help setup / help update    First-site setup and program update guidance
  help configure              Explicit policy changes and recovery
  help all                    Complete command reference

Examples
  pressharden status
  pressharden status -php --target example.com
  pressharden status -wp -updates example.com

Targets: one website, nested site, directory, or all. An omitted target selects
only the configured fleet; an invalid or empty target never expands the scope.
Color: --color=auto|always|never; NO_COLOR wins; auto respects TERM=dumb.
EOF
      ;;
    status)
      cat <<'EOF'

  status [target]               All supported overview areas (WordPress + PHP)
  check [target]                Alias for status
  status -wp/--wp              WordPress policy, file controls and update summary
  status -php/--php            Static local PHP policy only; no WP-CLI needed
  status -updates/--updates    Core/plugin/theme preferences and blockers
  status -locks/--locks        File-modification restriction
  status --verbose            Detailed values for the selected areas

Filters can be combined. Use one positional target or --target SITE.
OBSERVED = collected, REVIEW = items worth checking, INCOMPLETE = unreadable
or unsafe data, UNVERIFIED = effective web PHP is unknown. These are observations,
not security certification. Exit 0 = collected with no flagged review items,
1 = review items, 2 = incomplete/error. PHP web uncertainty alone does not fail
an otherwise complete inspection. No settings are changed by status or check.
EOF
      ;;
    setup|config|config-new|sites|doctor)
      cat <<'EOF'

Start with one staging installation, running as its owner:
  export PRESSHARDEN_SCAN_ROOT="/absolute/path/to/your/sites"
  pressharden config                    Show resolved paths and interaction mode
  pressharden sites                     List discovered local names/directories
  pressharden doctor --target SITE      Check dependencies and selected scope
  pressharden status --target SITE      Read WordPress and local PHP observations
  pressharden status -php --target SITE Static PHP inspection without WP-CLI

Use a name from sites, a nested site, or an absolute local directory. Omission
selects the configured fleet; a parent can include discovered nested installs.
config shows the private config path. config-new previews missing template
options without editing or executing that file. Configuration is trusted shell
code; keep it owner-controlled, mode 600, and outside website roots.
Read README.md for installation choices; help update explains program updates.
EOF
      ;;
    update)
      cat <<'EOF'

  pressharden update                   Replace this tool's managed program files
  pressharden config-new               Preview new private configuration options

Default source: marketania/PressHarden, branch main. This is moving source,
not automatic selection of a stable release. An explicit PRESSHARDEN_REF chooses
a branch or tag; PRESSHARDEN_UPDATE_ARCHIVE selects a local distribution archive.
Updates validate product identity and syntax, preserve private config/state,
and retain recovery data on failure. Stop other operations before updating.
Git working trees refuse self-update; review and update those through Git.
See docs/UPDATING.md for source selection, locks and recovery.
EOF
      ;;
    configure|php|updates|all)
      cat <<'EOF'

Read and compare
  status / check [target]             Combined concise overview
  status [-wp] [-php] [-updates] [-locks] [--verbose] [target]
  wp-settings [status] [target]       Full WordPress baseline and differences
  php status [target]                 Local/CLI PHP values; web effect unknown
  php inspect [target] [--details]    Advanced runtime/provider inspection
  auto-updates status [target]        Detailed preferences and blockers
  lock-status [target]                Configured file-modification restriction

Explicit policy changes (preflight, backup, confirmation and verification)
  wp-settings set SETTING VALUE [target]
  lock / unlock [target]
  file-mods status|on|off [target]     Equivalent advanced locking interface
  auto-updates core minor|major|disabled [target]
  auto-updates plugins enable|disable [target]
  auto-updates themes enable|disable [target]
  php set SETTING VALUE [target]      Guarded .user.ini change
  salts rotate auth|cache [target]    Atomic authentication/cache rotation

Settings: editor, cron, recovery, environment, development, debug, debug-display,
          debug-log, script-debug, savequeries, force-ssl-admin, alternate-cron.
Boolean values: enabled|disabled. See docs/WP-SETTINGS.md for other values.
PHP writes require verified web-SAPI context; on-disk changes are not web proof.
Backup/recovery paths are reported by each operation. Never blanket-change every
policy: hosting requirements and application behavior differ.

Utility: sites [directory] / doctor [target] / config / config-new / update /
         version / help [all|status|configure|php|updates|setup|update]
Use one positional target or --target SITE. Existing command aliases still work.
Color: --color=auto|always|never; NO_COLOR wins; auto respects TERM=dumb.
Omitted target selects the configured fleet. Unknown/empty targets fail closed.
EOF
      ;;
    *) printf 'Unknown help topic. Use help all, status, configure, php, updates, setup, or update.\n' >&2; return 2 ;;
  esac
}
show_config() {
  local state cache root
  root=$(resolve_root '') || return 2
  if [ "$PRESSHARDEN_PORTABLE" = 1 ]; then
    state="${PRESSHARDEN_STATE_DIR:-$PRESSHARDEN_DIR/var}"; cache="${PRESSHARDEN_CACHE_DIR:-$PRESSHARDEN_DIR/var/cache}"
  else
    state="${PRESSHARDEN_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/pressharden}"; cache="${PRESSHARDEN_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/pressharden}"
  fi
  printf 'PressHarden v%s\nProgram: %s\nConfig: %s\nRoot: %s\nState: %s\nCache: %s\nInteractive: %s\n' "$VERSION" "$PRESSHARDEN_DIR" "$CONFIG_FILE" "$root" "$state" "$cache" "${PRESSHARDEN_INTERACTIVE:-1}"
  printf 'Optional provider credentials: %s\n' "$([ -n "${PRESSHARDEN_HOSTINGER_API_TOKEN:-}" ] && printf configured || printf 'not configured')"
}

resolve_root() {
  local explicit="${1:-}" c parent
  if [ -n "$explicit" ]; then
    c="$explicit"
  elif [ -n "${PRESSHARDEN_SCAN_ROOT:-}" ]; then
    c="$PRESSHARDEN_SCAN_ROOT"
  elif [ "$PRESSHARDEN_PORTABLE" = 1 ]; then
    parent=$(cd "$PRESSHARDEN_DIR/.." 2>/dev/null && pwd -P || dirname "$PRESSHARDEN_DIR")
    if [ -d "$parent/domains" ]; then c="$parent/domains"
    elif [ -d "$parent/public_html" ]; then c="$parent/public_html"
    else c="$parent"
    fi
  elif [ -d "$HOME/domains" ]; then c="$HOME/domains"
  elif [ -d "$HOME/public_html" ]; then c="$HOME/public_html"
  elif [ -d /var/www ]; then c=/var/www
  else c="$PWD"
  fi
  if command -v php >/dev/null 2>&1; then php "$PRESSHARDEN_DIR/lib/target-path.php" "$PWD" "$c" || return 2; fi
  if command -v realpath >/dev/null 2>&1; then realpath "$c" 2>/dev/null || printf '%s' "$c"; else (cd "$c" 2>/dev/null && pwd -P) || printf '%s' "$c"; fi
}

# One resolver for every command accepting a site/directory. A failed name must
# never become an empty ROOT (which would silently broaden the operation).
select_target() {
  # Named targets are operands only; e.g. --target on cannot become file-mods on.
  [ "${_ph_named_target:-0}" -eq 0 ] || set -- "$@" "${_ph_target[@]}"
  local target="${1:-}" result scope line kind value first
  [ "$#" -le 1 ] || { printf 'Use one website name, directory, or all.\n' >&2; return 2; }
  [ "$#" -eq 0 ] || [ -n "$target" ] || { printf "Explicit target cannot be empty.\n" >&2; return 2; }
  [ -z "$target" ] || [ ! -L "$target" ] || { printf "Symlink target refused.\n" >&2; return 2; }
  TARGET_NAME=''; TARGET_COUNT=''
  _PH_FLEET_ROOT=$(resolve_root '') || return 2
  export _PH_FLEET_ROOT
  case "$target" in
    ''|all) ROOT=$(resolve_root '') || return 2 ;;
    /*|./*|../*|.|..|~/*) ROOT=$(resolve_root "$target") || return 2 ;;
    *)
      if [[ "$target" != *.* && "$target" != *://* ]] && [ -d "$target" ]; then
        ROOT=$(resolve_root "$target") || return 2
      else
        scope=$(resolve_root '') || return 2
        result=$(bash "$PRESSHARDEN_DIR/lib/site-target.sh" "$scope" "$target") || return 2
        first=${result%%$'\n'*}
        IFS=$'\t' read -r ROOT TARGET_NAME TARGET_COUNT <<< "$first"
        _PH_TARGET_EXCLUSIONS=''
        while IFS=$'\t' read -r kind value; do
          [ "$kind" != E ] || _PH_TARGET_EXCLUSIONS+="$value"$'\n'
        done <<< "$result"
        export _PH_TARGET_EXCLUSIONS
        [ -d "$ROOT" ] && [ -n "$TARGET_NAME" ] || return 2
        printf 'Target: %s' "$TARGET_NAME" >&2
        [ "${TARGET_COUNT:-1}" -le 1 ] || printf ' (%s installations, including nested sites)' "$TARGET_COUNT" >&2
        printf '\n' >&2
      fi ;;
  esac
  export ROOT PRESSHARDEN_DIR
}

confirm_fleet_file_mods() {
  local action="$1" root="$2" verb ans=''
  [ "$action" = on ] && verb='LOCK' || verb='UNLOCK'
  if [ "${PRESSHARDEN_INTERACTIVE:-1}" = "0" ]; then return 0; fi
  if [ -r /dev/tty ] && [ -w /dev/tty ]; then
    if [ -n "${TARGET_NAME:-}" ]; then
      printf '\n  %s %s (%s installation(s))? [y/N]: ' "$verb" "$TARGET_NAME" "${TARGET_COUNT:-1}" > /dev/tty
    else
      printf '\n  %s all discovered websites under %s? [y/N]: ' "$verb" "$root" > /dev/tty
    fi
    IFS= read -r ans < /dev/tty || ans=''
    case "$ans" in y|Y|yes|YES) return 0 ;; *) printf 'Cancelled.\n'; return 1 ;; esac
  fi
  printf 'Refusing fleet %s without an interactive terminal. Set PRESSHARDEN_INTERACTIVE=0 to run intentionally in automation.\n' "${verb,,}" >&2
  return 1
}

confirm_auto_update_change() {
  local area="$1" value="$2" root="$3" ans=''
  if [ "${PRESSHARDEN_INTERACTIVE:-1}" = "0" ]; then return 0; fi
  if [ -r /dev/tty ] && [ -w /dev/tty ]; then
    if [ -n "${TARGET_NAME:-}" ]; then
      printf '\n  Set %s auto-updates to %s for %s (%s installation(s))? [y/N]: ' "$area" "$value" "$TARGET_NAME" "${TARGET_COUNT:-1}" > /dev/tty
    else
      printf '\n  Set %s auto-updates to %s for all discovered websites under %s? [y/N]: ' "$area" "$value" "$root" > /dev/tty
    fi
    IFS= read -r ans < /dev/tty || ans=''
    case "$ans" in y|Y|yes|YES) return 0 ;; *) printf 'Cancelled.\n'; return 1 ;; esac
  fi
  printf 'Refusing fleet auto-update change without an interactive terminal. Set PRESSHARDEN_INTERACTIVE=0 to run intentionally in automation.\n' >&2
  return 1
}

confirm_wp_setting_change() {
  local setting="$1" value="$2" root="$3" ans=''
  if [ "${PRESSHARDEN_INTERACTIVE:-1}" = "0" ]; then return 0; fi
  if [ -r /dev/tty ] && [ -w /dev/tty ]; then
    if [ -n "${TARGET_NAME:-}" ]; then
      printf '\n  Set %s=%s for %s (%s installation(s))? [y/N]: ' "$setting" "$value" "$TARGET_NAME" "${TARGET_COUNT:-1}" > /dev/tty
    else
      printf '\n  Set %s=%s for all discovered websites under %s? [y/N]: ' "$setting" "$value" "$root" > /dev/tty
    fi
    IFS= read -r ans < /dev/tty || ans=''
    case "$ans" in y|Y|yes|YES) return 0 ;; *) printf 'Cancelled.\n'; return 1 ;; esac
  fi
  printf 'Refusing fleet wp-settings change without an interactive terminal. Set PRESSHARDEN_INTERACTIVE=0 to run intentionally in automation.\n' >&2
  return 1
}


cmd="${1:-help}"; [ "$#" -gt 0 ] && shift || true
case "$cmd" in
  -V|--version|version) [ "$#" -eq 0 ] && [ "$_ph_named_target" -eq 0 ] || { printf 'Usage: pressharden version\n' >&2; exit 2; }; printf 'PressHarden %s\n' "$VERSION" ;;
  help|-h|--help) [ "$_ph_named_target" -eq 0 ] || { printf 'Help does not take a website target. Use pressharden help all.\n' >&2; exit 2; }; usage "$@" ;;
  config) [ "$#" -eq 0 ] && [ "$_ph_named_target" -eq 0 ] || { printf 'Usage: pressharden config\n' >&2; exit 2; }; show_config ;;
  sites)
    [ "$_ph_named_target" -eq 0 ] || set -- "$@" "${_ph_target[@]}"
    [ "$#" -le 1 ] || { printf 'Usage: ./pressharden sites [directory]\n' >&2; exit 2; }
    [ "$#" -eq 0 ] || [ -n "$1" ] || { printf 'Explicit target cannot be empty.\n' >&2; exit 2; }
    _PH_FLEET_ROOT=$(resolve_root '') || exit 2
    export _PH_FLEET_ROOT
    ROOT=$(resolve_root "${1:-}") || exit 2
    exec bash "$PRESSHARDEN_DIR/lib/site-target.sh" "$ROOT" --list
    ;;
  update)
    [ "$#" -eq 0 ] && [ "$_ph_named_target" -eq 0 ] || { printf 'Usage: pressharden update\n' >&2; exit 2; }
    # shellcheck disable=SC1090
    . "$PRESSHARDEN_DIR/lib/update.sh"
    ph_update
    ;;
  lock|unlock)
    select_target "$@" || exit 2
    action=on; [ "$cmd" = unlock ] && action=off
    confirm_fleet_file_mods "$action" "$ROOT" || exit 1
    export PRESSHARDEN_INTERACTIVE=0
    exec bash "$PRESSHARDEN_DIR/checks/file-mods.sh" "$action"
    ;;
  lock-status)
    select_target "$@" || exit 2
    exec bash "$PRESSHARDEN_DIR/checks/file-mods.sh" status
    ;;
  wp-settings)
    sub="${1:-status}"
    if [ "$sub" = status ]; then
      shift || true
      [ "$#" -le 1 ] || { printf 'Usage: ./pressharden wp-settings [website|directory|all]\n' >&2; exit 2; }
      select_target "$@" || exit 2
      exec bash "$PRESSHARDEN_DIR/checks/wp-settings.sh" status
    elif [ "$sub" = set ]; then
      shift || true
      setting="${1:-}"; value="${2:-}"; target="${3:-}"
      [ "$#" -ge 2 ] && [ "$#" -le 3 ] || { printf 'Usage: ./pressharden wp-settings set SETTING VALUE [website|directory|all]\n' >&2; exit 2; }
      case "$setting" in
        editor|cron|recovery|debug|debug-display|debug-log|script-debug|savequeries|force-ssl-admin|alternate-cron)
          case "$value" in enabled|disabled) : ;; *) printf '%s must be enabled or disabled.\n' "$setting" >&2; exit 2 ;; esac ;;
        environment)
          case "$value" in production|staging|development|local) : ;; *) printf 'environment must be production, staging, development, or local.\n' >&2; exit 2 ;; esac ;;
        development)
          case "$value" in disabled|core|plugin|theme|all) : ;; *) printf 'development must be disabled, core, plugin, theme, or all.\n' >&2; exit 2 ;; esac ;;
        *) printf 'Supported wp-settings setters: editor, cron, recovery, environment, development, debug, force-ssl-admin, alternate-cron.\n' >&2; exit 2 ;;
      esac
      [ "$#" -ne 3 ] || [ -n "$target" ] || { printf "Empty target refused.\n" >&2; exit 2; }
      if [ -n "$target" ]; then select_target "$target" || exit 2; else select_target || exit 2; fi
      confirm_wp_setting_change "$setting" "$value" "$ROOT" || exit 1
      export PRESSHARDEN_POLICY_APPLY=1 PRESSHARDEN_INTERACTIVE=0
      exec bash "$PRESSHARDEN_DIR/checks/wp-settings.sh" set "$setting" "$value"
    else
      [ "$#" -le 1 ] || { printf 'Usage: ./pressharden wp-settings [website|directory|all]\n' >&2; exit 2; }
      select_target "$@" || exit 2
      exec bash "$PRESSHARDEN_DIR/checks/wp-settings.sh" status
    fi
    ;;
  auto-updates|auto-update)
    area="${1:-status}"; [ "$#" -gt 0 ] && shift || true
    case "$area" in
      status)
        [ "$#" -le 1 ] || { printf 'Usage: ./pressharden auto-updates status [website|directory|all]\n' >&2; exit 2; }
        select_target "$@" || exit 2
        exec bash "$PRESSHARDEN_DIR/checks/wp-auto-updates.sh" status
        ;;
      core)
        value="${1:-}"; [ "$#" -gt 0 ] && shift || true
        case "$value" in minor|major|disabled) : ;; disable) value=disabled ;; *) printf 'Core policy must be minor, major, or disabled.\n' >&2; exit 2 ;; esac
        [ "$#" -le 1 ] || { printf 'Usage: ./pressharden auto-updates core minor|major|disabled [website|directory|all]\n' >&2; exit 2; }
        select_target "$@" || exit 2
        confirm_auto_update_change CORE "$value" "$ROOT" || exit 1
        export PRESSHARDEN_INTERACTIVE=0
        exec bash "$PRESSHARDEN_DIR/checks/wp-auto-updates.sh" core "$value"
        ;;
      plugins|themes)
        value="${1:-}"; [ "$#" -gt 0 ] && shift || true
        case "$value" in enable|disable) : ;; *) printf '%s policy must be enable or disable.\n' "$area" >&2; exit 2 ;; esac
        [ "$#" -le 1 ] || { printf 'Usage: ./pressharden auto-updates %s enable|disable [website|directory|all]\n' "$area" >&2; exit 2; }
        select_target "$@" || exit 2
        confirm_auto_update_change "${area^^}" "$value" "$ROOT" || exit 1
        export PRESSHARDEN_INTERACTIVE=0
        exec bash "$PRESSHARDEN_DIR/checks/wp-auto-updates.sh" "$area" "$value"
        ;;
      *) printf 'Use auto-updates status, core, plugins, or themes.\n' >&2; exit 2 ;;
    esac
    ;;
  file-mods)
    action="${1:-status}"; [ "$#" -gt 0 ] && shift || true
    select_target "$@" || exit 2
    exec bash "$PRESSHARDEN_DIR/checks/file-mods.sh" "$action"
    ;;
  status|check)
    status_areas=(); status_target=(); status_verbose=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -wp|--wp) status_areas+=(wp) ;;
        -php|--php) status_areas+=(php) ;;
        -updates|--updates) status_areas+=(updates) ;;
        -locks|--locks) status_areas+=(locks) ;;
        --verbose|-v) status_verbose=1 ;;
        --help|-h) usage status; exit $? ;;
        -*) printf 'Unknown status option: %s. See pressharden help status.\n' "$1" >&2; exit 2 ;;
        *) status_target+=("$1") ;;
      esac
      shift
    done
    [ "${#status_areas[@]}" -ne 0 ] || status_areas=(wp php)
    select_target "${status_target[@]}" || exit 2
    status_area_list=$(IFS=,; printf '%s' "${status_areas[*]}")
    exec bash "$PRESSHARDEN_DIR/checks/status.sh" "$status_area_list" "$status_verbose" ;;
  doctor)
    select_target "$@" || exit 2
    exec bash "$PRESSHARDEN_DIR/checks/doctor.sh" ;;
  php)
    sub="${1:-status}"; [ "$#" -gt 0 ] && shift || true
    case "$sub" in
      status) select_target "$@" || exit 2; exec bash "$PRESSHARDEN_DIR/checks/php-policy.sh" status ;;
      inspect)
        if [ "${*: -1}" = --details ]; then export PRESSHARDEN_PHP_DETAILS=1; set -- "${@:1:$#-1}"; fi
        select_target "$@" || exit 2; exec bash "$PRESSHARDEN_DIR/checks/php-runtime.sh" ;;
      set)
        [ "$#" -ge 2 ] && [ "$#" -le 3 ] || { printf 'Usage: pressharden php set SETTING VALUE [target]\n' >&2; exit 2; }
        setting="$1"; value="$2"; shift 2
        select_target "$@" || exit 2
        exec bash "$PRESSHARDEN_DIR/checks/php-policy.sh" set "$setting" "$value" ;;
      *) printf 'Use php status, php inspect or php set.\n' >&2; exit 2 ;;
    esac ;;
  salts)
    [ "$#" -ge 2 ] && [ "$#" -le 3 ] && [ "$1" = rotate ] || { printf 'Usage: pressharden salts rotate auth|cache [target]\n' >&2; exit 2; }
    kind="$2"; shift 2
    case "$kind" in auth|cache) ;; *) printf 'Use auth or cache.\n' >&2; exit 2 ;; esac
    select_target "$@" || exit 2
    exec bash "$PRESSHARDEN_DIR/checks/salts.sh" "$kind" ;;
  *) printf "Unknown PressHarden command: %s\n" "$cmd" >&2; exit 2 ;;
esac
